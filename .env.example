# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Yandex Maps
NEXT_PUBLIC_YANDEX_MAPS_KEY=your_yandex_maps_key
# Опционально: отдельный ключ для Yandex Geocoder HTTP API (Suggest/Geocode),
# если он отличается от ключа JS Maps API выше. Если не задан — используется
# NEXT_PUBLIC_YANDEX_MAPS_KEY.
YANDEX_GEOCODER_KEY=

# Email (Resend)
RESEND_API_KEY=re_xxxx

# Оплата Pro (TipTop Pay). Пока BILLING_PROVIDER пуст, кнопка оплаты показывает «скоро».
# Уведомления в кабинете TipTop Pay: https://<домен>/api/billing/webhook?type=check|pay|fail|recurrent
BILLING_PROVIDER=tiptoppay
TIPTOPPAY_PUBLIC_ID=
TIPTOPPAY_API_SECRET=

# Admins (через запятую, без пробелов)
ADMIN_EMAILS=medetsovetov09@gmail.com,diaskalm45@gmail.com
